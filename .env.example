# Skopiuj ten plik jako .env.local i uzupełnij wartości. Plik .env.local NIE trafia do GitHuba.

# --- Adres sklepu (używany w metadanych i później w linkach z płatności) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Baza danych ---
# Lokalnie: zostaw DATABASE_URL puste → używana jest wbudowana baza PGlite w katalogu PGLITE_DIR.
# Na serwerze: ustaw adres PostgreSQL, np. postgres://mart:haslo@127.0.0.1:5432/mart
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Lokalnie migracje i dane demo wgrywają się same przy starcie serwera.
# Na serwerze ustaw AUTO_MIGRATE=false i uruchamiaj `npm run db:migrate` przy wdrożeniu.
AUTO_MIGRATE=
SEED_DEMO_DATA=true

# --- Pierwsze konto administratora ---
# Tworzone przy starcie TYLKO, gdy w bazie nie ma jeszcze żadnego admina. Hasło min. 10 znaków.
ADMIN_EMAIL=admin@mart.local
ADMIN_PASSWORD=ZmienMnie123!

# --- Zdjęcia produktów wgrywane w panelu ---
UPLOAD_DIR=./storage/uploads

# --- Integracje (etapy 6–7, na razie nieużywane) ---
# PAYMENT_PROVIDER=przelewy24
# P24_MERCHANT_ID=
# P24_POS_ID=
# P24_CRC=
# P24_API_KEY=
# P24_SANDBOX=true
# SHIPPING_PROVIDER=inpost
# INPOST_API_TOKEN=
# INPOST_ORGANIZATION_ID=
# INPOST_SANDBOX=true
