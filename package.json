{
  "name": "m-art-sklep",
  "version": "0.1.0",
  "private": true,
  "description": "Sklep internetowy M.art - Pracownia Bizuterii (Next.js + MariaDB/MySQL)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:reset": "tsx scripts/reset-db.mts",
    "admin:create": "tsx scripts/create-admin.mts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "db:start": "tsx scripts/db-start.mts",
    "db:import-pglite": "tsx scripts/import-pglite.mts",
    "deploy:build": "tsx scripts/build-deploy.mts"
  },
  "dependencies": {
    "@fontsource/cormorant": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/italianno": "5.3.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "ffmpeg-static": "5.3.0",
    "mysql2": "3.24.6",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
